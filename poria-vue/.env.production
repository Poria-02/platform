# 页面标题
VITE_APP_TITLE = Poria 管理台

# 生产环境配置
VITE_APP_ENV = 'production'

# 若依管理系统/生产环境
VITE_APP_BASE_API = 'https://gateway.example.com'
VITE_AUTH_PREFIX = '/auth'
VITE_UPMS_PREFIX = '/upms'
# 生产部署时由环境注入已注册、允许 plat 授权类型的浏览器客户端 ID。
VITE_AUTH_CLIENT_ID = ''
VITE_AUTH_SCOPE = 'server'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip
