# 页面标题
VITE_APP_TITLE = Poria 管理台

# 开发环境配置
VITE_APP_ENV = 'development'

# 若依管理系统/开发环境
VITE_APP_BASE_API = '/api'
VITE_GATEWAY_TARGET = 'http://localhost:9999'
# Gateway 暂未注册 /upms 路由时由 Vite 直连本机 UPMS；仅开发环境使用。
VITE_UPMS_TARGET = 'http://localhost:4000'
# Gateway 会依次将 auth/upms 前缀转发到对应微服务。
VITE_AUTH_PREFIX = '/auth'
VITE_UPMS_PREFIX = '/upms'
# 本地联调 OAuth 客户端；VITE_* 会暴露给浏览器，禁止复制到生产环境。
VITE_AUTH_CLIENT_ID = 'test'
VITE_AUTH_CLIENT_SECRET = 'test'
VITE_AUTH_SCOPE = 'server'
# PlatLoginModel.userType。按本管理台在 sys_menu.platform 中使用的业务值配置。
VITE_AUTH_USER_TYPE = ''
